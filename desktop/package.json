{
  "name": "reelbox-desktop",
  "version": "0.1.0",
  "description": "Local media downloader and library",
  "author": "Reel Box",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "prepare:mac": "node scripts/prepare.cjs darwin-arm64",
    "prepare:win": "node scripts/prepare.cjs win32-x64",
    "build:mac": "electron-builder --mac zip --arm64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.cjs",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "local.reelbox.desktop",
    "productName": "Reel Box",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "splash.html",
      "package.json",
      "assets/icon.png",
      "browser-window.cjs",
      "browser-media.cjs",
      "browser-preload.cjs",
      "browser-ui.js",
      "browser.html",
      "browser-page.cjs",
      "browser-batch.cjs"
    ],
    "extraResources": [
      {
        "from": "payload/${os}-${arch}",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "web",
        "to": "web"
      },
      {
        "from": "../backend/app",
        "to": "backend/app",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "identity": "-",
      "target": [
        "zip"
      ],
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "\uc2dc\uc2a4\ud15c \ud654\uba74 \uacf5\uc720 \uae30\ub2a5\uc73c\ub85c \uc0ac\uc6a9\uc790\uac00 \uc120\ud0dd\ud55c \uc601\uc0c1 \uc18c\ub9ac\ub97c \ud3ec\ud568\ud560 \ub54c \uc0ac\uc6a9\ud569\ub2c8\ub2e4.",
        "NSScreenCaptureUsageDescription": "\uc0ac\uc6a9\uc790\uac00 \uc9c1\uc811 \uc120\ud0dd\ud55c \ud654\uba74\uc774\ub098 \ucc3d\uc744 \ub179\ud654\ud569\ub2c8\ub2e4."
      },
      "icon": "assets/icon.icns",
      "artifactName": "Reel-Box-${version}-macOS-arm64.zip"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Reel-Box-${version}-Windows-x64-Setup.exe",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
